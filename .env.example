# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Legacy fallback for projects that have not switched API keys yet:
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Resources website URL
NEXT_PUBLIC_RESOURCES_WEBSITE_URL=

# Resend (email backup for reminders)
RESEND_API_KEY=

# Google Gemini (AI). Add your private key only to .env.local.
GEMINI_API_KEY=
# Optional. If you see "does not know the model", set a model name listed in Google AI Studio.
GEMINI_MODEL=gemini-3.5-flash-lite
# AI login rule. In production the AI route needs a signed-in account by default.
# Set to false only if you want anyone to use it (not recommended), or true to require login in development too.
AI_REQUIRE_LOGIN=
